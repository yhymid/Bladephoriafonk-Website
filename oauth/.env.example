PORT=3001
HOST=127.0.0.1
BASE_URL=https://bladephoriafonk.xyz
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://bladephoriafonk.xyz/auth/discord/callback
COOKIE_NAME=bpf_session
COOKIE_SECURE=true
# Site directory (the one with index.html). Default: the working directory.
SITE_ROOT=/home/ubuntu/Main Files/Website
# Profile page template served at /profile/<slug>/ (default: SITE_ROOT/profile/index.html).
#PROFILE_TEMPLATE_FILE=/home/ubuntu/Main Files/Website/profile/index.html
PROFILE_DB_FILE=/var/lib/bladephoria/profiles.json
CHANGELOG_DB_FILE=/var/lib/bladephoria/changelog.json
# Saved logins (Discord tokens), written with mode 0600.
SESSION_DB_FILE=/var/lib/bladephoria/sessions.json
MEDIA_ROOT=/home/ubuntu/Main Files/Website/media
ADMIN_USER_IDS=780552865445969920
ADMIN_USERNAMES=yhym,!yhym's
JSON_BODY_LIMIT_BYTES=8388608
CHANGELOG_JSON_BODY_LIMIT_BYTES=33554432
SESSION_DATA_TTL_MS=300000
INVITE_CACHE_TTL_MS=60000
# Most login attempts waiting for Discord (0 = no limit).
MAX_PENDING_LOGINS=10000
# Profile/changelog files with a broken structure (e.g. truncated to "{}") are refused
# instead of being read as empty; 0 = the old behaviour.
STRICT_DATA_FILES=1
# Read-only admin panel on 127.0.0.1:<port>, opened through an SSH tunnel
# (scripts/admin-tunnel.sh). 0 = off. ADMIN_PANEL_UNIT is the systemd unit
# whose log it shows.
ADMIN_PANEL_PORT=0
#ADMIN_PANEL_UNIT=bladephoria-oauth
# Diagnostics 24/7 (see README.md). 1 = on.
BLADEPHORIA_DIAGNOSTICS=0
#BLADEPHORIA_DIAGNOSTICS_DIR=/home/ubuntu/Main Files/Website/diagnostics
#BLADEPHORIA_DIAGNOSTICS_RETENTION_DAYS=14
#BLADEPHORIA_DIAGNOSTICS_MAX_MB=50
#BLADEPHORIA_DIAGNOSTICS_SUMMARY_MINUTES=15
