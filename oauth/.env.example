PORT=3001
HOST=127.0.0.1
BASE_URL=https://bladephoriafonk.xyz
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://bladephoriafonk.xyz/auth/discord/callback
COOKIE_NAME=bpf_session
COOKIE_SECURE=true
# Katalog strony (ten z index.html). Domyslnie katalog roboczy procesu.
SITE_ROOT=/home/ubuntu/Main Files/Website
# true: serwer Rust wystawia tez strony i assety. false: tylko API /auth/*.
SERVE_STATIC=true
PROFILE_ROOT=/home/ubuntu/Main Files/Website/profile
PROFILE_SOURCE_ROOT=/home/ubuntu/Main Files/Website/src/profile
PROFILE_TEMPLATE_FILE=/home/ubuntu/Main Files/Website/oauth/profile-template.html
PROFILE_DB_FILE=/var/lib/bladephoria/profiles.json
CHANGELOG_DB_FILE=/var/lib/bladephoria/changelog.json
MEDIA_ROOT=/home/ubuntu/Main Files/Website/media
ADMIN_USER_IDS=780552865445969920
ADMIN_USERNAMES=yhym,!yhym's
JSON_BODY_LIMIT_BYTES=8388608
CHANGELOG_JSON_BODY_LIMIT_BYTES=33554432
SESSION_DATA_TTL_MS=300000
INVITE_CACHE_TTL_MS=60000
