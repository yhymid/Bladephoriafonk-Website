server {
    listen 80;
    listen [::]:80;
    server_name bladephoriafonk.xyz www.bladephoriafonk.xyz;
    return 301 https://$host$request_uri;
}

# Nginx only terminates TLS. Pages, assets, media and /auth/* are all served
# by the Rust server, which also sets the security headers and decides which
# paths are public.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name bladephoriafonk.xyz www.bladephoriafonk.xyz;

    ssl_certificate /etc/letsencrypt/live/bladephoriafonk.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bladephoriafonk.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Changelog posts may carry large JSON bodies (CHANGELOG_JSON_BODY_LIMIT_BYTES).
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Stream large media downloads instead of spooling them to disk.
        proxy_max_temp_file_size 0;
    }
}
