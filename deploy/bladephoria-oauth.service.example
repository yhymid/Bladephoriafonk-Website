[Unit]
Description=Bladephoria Discord OAuth Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Main Files/website/oauth
EnvironmentFile=/home/ubuntu/.bladephoria-oauth.env
ExecStart=/usr/bin/node --env-file=/home/ubuntu/.bladephoria-oauth.env /home/ubuntu/Main Files/website/oauth/discord-auth-server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
