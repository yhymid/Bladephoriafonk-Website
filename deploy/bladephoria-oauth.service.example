[Unit]
Description=Bladephoria Website Server (Rust)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Main Files/Website
ExecStart="/home/ubuntu/Main Files/Website/bladephoria-web" --env-file "/home/ubuntu/Main Files/Website/oauth/.env"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
